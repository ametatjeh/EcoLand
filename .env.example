APP_NAME="Eco Land"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://ikhw.org

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database Configuration (MySQL / MariaDB Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecoland_prod
DB_USERNAME=ecoland_user
DB_PASSWORD=

# Session, Cache & Queue Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
ADMIN_IDLE_TIMEOUT=30
ADMIN_IDLE_WARNING=5
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

# Cache Configuration (file / redis)
CACHE_STORE=file

# Redis Configuration (High-Performance Cache, Session & Queue)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=eco_land_

# Memcached Configuration (Optional)
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ikhw.org"
MAIL_FROM_NAME="${APP_NAME}"

# Marzipano Virtual Tour Paths
MARZIPANO_STATIC_TILES_PATH=/tiles
MARZIPANO_STATIC_TOURS_PATH=/tours

# Google OAuth SSO Configuration (Kosongkan GOOGLE_REDIRECT_URI untuk deteksi otomatis domain & HTTPS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Google reCAPTCHA v3 Configuration (Admin Login Protection)
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_LOGIN_ACTION=login
RECAPTCHA_ALLOWED_HOSTNAMES=
